{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sigma4.org/schema/project.schema.json",
  "title": "SIGMA4 Project Document",
  "type": "object",
  "required": [
    "project",
    "building",
    "assembly",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "schemaVersion",
        "projectId",
        "projectName",
        "units",
        "rulesetId",
        "rulesetVersion",
        "generatorVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "description": "v1.1.0 wall origins denote outside lower corners; v1.0.0 is imported using midplane migration"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "projectName": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "const": "mm"
        },
        "rulesetId": {
          "type": "string",
          "minLength": 1
        },
        "rulesetVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generatorVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "building": {
      "type": "object",
      "required": [
        "materials",
        "walls",
        "openings",
        "markers"
      ],
      "additionalProperties": false,
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "densityKgM3"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "densityKgM3": {
                "type": "number",
                "minimum": 1
              },
              "strengthClass": {
                "type": "string"
              }
            }
          },
          "uniqueItems": true
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "wallId",
              "lengthMm",
              "heightMm",
              "thicknessMm",
              "studSpacingMm",
              "sectionMm",
              "orientation",
              "origin",
              "openings"
            ],
            "additionalProperties": false,
            "properties": {
              "wallId": {
                "type": "string",
                "minLength": 1
              },
              "lengthMm": {
                "type": "number",
                "minimum": 1
              },
              "heightMm": {
                "type": "number",
                "minimum": 1
              },
              "thicknessMm": {
                "type": "number",
                "minimum": 1
              },
              "studSpacingMm": {
                "type": "number",
                "minimum": 1
              },
              "sectionMm": {
                "type": "object",
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "number",
                    "minimum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              },
              "orientation": {
                "enum": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "origin": {
                "type": "object",
                "description": "Schema 1.1.0: lower outer corner in millimetres, X outside +Z face, Z outside +X face.",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              },
              "openings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reversed": {
                "const": true,
                "description": "Rotate the standard wall frame by 180 degrees."
              }
            }
          },
          "uniqueItems": true
        },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "wallId",
              "type",
              "positionUmm",
              "widthMm",
              "heightMm",
              "sillHeightMm"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "wallId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "window",
                  "door",
                  "garage-door"
                ]
              },
              "positionUmm": {
                "type": "number",
                "minimum": 0
              },
              "widthMm": {
                "type": "number",
                "minimum": 1
              },
              "heightMm": {
                "type": "number",
                "minimum": 1
              },
              "sillHeightMm": {
                "type": "number",
                "minimum": 0
              },
              "garage": {
                "type": "object",
                "required": [
                  "installationProfile",
                  "minSideRoomMm",
                  "minHeadRoomMm",
                  "minBackRoomExtraMm",
                  "lintelPreviewDepthMm",
                  "jackStudsPerSide"
                ],
                "additionalProperties": false,
                "properties": {
                  "installationProfile": {
                    "const": "clopay-standard-torsion"
                  },
                  "minSideRoomMm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3000
                  },
                  "minHeadRoomMm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3000
                  },
                  "minBackRoomExtraMm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3000
                  },
                  "lintelPreviewDepthMm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3000
                  },
                  "jackStudsPerSide": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  }
                }
              }
            },
            "if": {
              "properties": {
                "type": {
                  "const": "garage-door"
                }
              }
            },
            "then": {
              "required": [
                "garage"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "garage"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "openingId",
              "anchor",
              "outsideOffsetMm",
              "elevationMm",
              "visible",
              "color"
            ],
            "additionalProperties": false,
            "properties": {
              "openingId": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "enum": [
                  "center",
                  "left",
                  "right"
                ]
              },
              "outsideOffsetMm": {
                "type": "number"
              },
              "elevationMm": {
                "type": "number"
              },
              "visible": {
                "type": "boolean"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "floorPlan": {
          "type": "object",
          "description": "SIGMA4 0.1.12: graph.nodes/graph.edges are canonical for freely drafted walls; interiorWalls remains [] for graph documents or stores legacy v0.1.11 wall data until conversion.",
          "additionalProperties": false,
          "required": [
            "exterior",
            "closed",
            "interiorWalls"
          ],
          "properties": {
            "exteriorThicknessMm": {
              "type": "integer",
              "minimum": 50,
              "maximum": 500,
              "description": "Optional outward envelope wall thickness, visually extruded inwards; 150 mm if absent"
            },
            "exterior": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "xMm",
                  "zMm"
                ],
                "properties": {
                  "xMm": {
                    "type": "integer",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "zMm": {
                    "type": "integer",
                    "minimum": -100000,
                    "maximum": 100000
                  }
                }
              }
            },
            "closed": {
              "type": "boolean"
            },
            "graph": {
              "type": "object",
              "description": "Canonical authored interior nodes and wall edges; when present interiorWalls is an empty legacy placeholder",
              "additionalProperties": false,
              "required": ["nodes", "edges"],
              "properties": {
                "nodes": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "xMm", "zMm"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "xMm": {"type": "integer", "minimum": -100000, "maximum": 100000},
                      "zMm": {"type": "integer", "minimum": -100000, "maximum": 100000}
                    }
                  }
                },
                "edges": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "a", "b", "thicknessMm"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "a": {"type": "string", "minLength": 1},
                      "b": {"type": "string", "minLength": 1},
                      "thicknessMm": {"type": "integer", "minimum": 50, "maximum": 500}
                    }
                  }
                }
              }
            },
            "interiorWalls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "start",
                  "end",
                  "thicknessMm"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "xMm",
                      "zMm"
                    ],
                    "properties": {
                      "xMm": {
                        "type": "integer",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "zMm": {
                        "type": "integer",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    }
                  },
                  "end": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "xMm",
                      "zMm"
                    ],
                    "properties": {
                      "xMm": {
                        "type": "integer",
                        "minimum": -100000,
                        "maximum": 100000
                      },
                      "zMm": {
                        "type": "integer",
                        "minimum": -100000,
                        "maximum": 100000
                      }
                    }
                  },
                  "thicknessMm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "frame": {
              "type": "object",
              "description": "Authored exterior openings use distances from the outer corner, not from the generated panel origin.",
              "required": [
                "built",
                "openings"
              ],
              "additionalProperties": false,
              "properties": {
                "built": {
                  "type": "boolean"
                },
                "openings": {
                  "type": "array",
                  "items": {
                    "$ref": "#/properties/building/properties/openings/items"
                  }
                }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fromWallId",
              "toWallId",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "fromWallId": {
                "type": "string",
                "minLength": 1
              },
              "toWallId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "california-right",
                  "end-to-end"
                ]
              }
            }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "required": [
        "elements"
      ],
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "elementId",
              "wallId",
              "role",
              "sectionMm",
              "lengthMm",
              "orientation",
              "position",
              "connectionIds",
              "generated"
            ],
            "additionalProperties": false,
            "properties": {
              "elementId": {
                "type": "string",
                "minLength": 1
              },
              "wallId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "stud",
                  "king-stud",
                  "jack-stud",
                  "cripple-stud",
                  "cripple-bottom",
                  "cripple-top",
                  "bottom-plate",
                  "top-plate",
                  "header",
                  "sill",
                  "corner-backing",
                  "garage-lintel-preview"
                ]
              },
              "sectionMm": {
                "type": "object",
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false,
                "properties": {
                  "width": {
                    "type": "number",
                    "minimum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              },
              "lengthMm": {
                "type": "number",
                "minimum": 1
              },
              "orientation": {
                "type": "object",
                "required": [
                  "mode",
                  "angle",
                  "roll"
                ],
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": [
                      "x",
                      "y",
                      "z",
                      "slope"
                    ]
                  },
                  "angle": {
                    "type": "number"
                  },
                  "roll": {
                    "type": "number"
                  }
                }
              },
              "position": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              },
              "connectionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "generated": {
                "type": "boolean"
              }
            }
          },
          "uniqueItems": true
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "valid",
        "issues",
        "engineeringStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "path",
              "messageRu",
              "affectedIds"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "path": {
                "type": "string"
              },
              "messageRu": {
                "type": "string"
              },
              "affectedIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "engineeringStatus": {
          "enum": [
            "not_evaluated",
            "passed",
            "failed"
          ]
        }
      }
    }
  }
}
